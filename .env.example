# No model key is required. .env is not loaded automatically.
# Set in your shell before starting the web server:
# CODE_SEARCH_BACKEND=mcp_stdio
# Or set CODE_SEARCH_BACKEND=local for direct in-process comparison.
# MCP failures return upstream_error; no silent fallback.

CODE_SEARCH_BACKEND=mcp_stdio
# Optional Gemini Developer API. .env is a template, NOT auto-loaded.
# The UI automatically uses Gemini when ENABLE_GEMINI=1; verify your key project is Free Tier first.
ENABLE_GEMINI=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1024

# No API key is required. Environment variables are optional.
# .env is documentation only; the application does not automatically load it.
# Set this in your shell to use a different reviewed corpus:
# TRAVEL_OPS_KNOWLEDGE_PATH=knowledge/peach.json
# Default for the web application: real MCP stdio transport.
# CODE_SEARCH_BACKEND=mcp_stdio
# For direct in-process comparison, explicitly set CODE_SEARCH_BACKEND=local.
# No automatic fallback: MCP failures return upstream_error.
